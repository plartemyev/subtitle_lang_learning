#. Pedagogical grammar symbols (Montessori): per-category explanations.
msgid "pos_tip_noun"
msgstr "A person, place or thing. Montessori: the pyramid — solid and stable, things exist."

msgid "pos_tip_propn"
msgstr "The name of a particular person, place or thing. Marked with a star above the noun pyramid."

msgid "pos_tip_art"
msgstr "Introduces a noun: 'a', 'the'. Montessori: a small companion of the noun pyramid."

msgid "pos_tip_adj"
msgstr "Describes a noun: 'good', 'first'. Montessori: the dark-blue triangle leaning on the pyramid."

msgid "pos_tip_verb"
msgstr "An action or a state: 'run', 'be', 'know'. Montessori: the red sphere — it moves, like the sun."

msgid "pos_tip_aux"
msgstr "A helper beside the main verb: 'is', 'have'. Extension: the verb's sphere, hollow."

msgid "pos_tip_part"
msgstr "A small word with a fixed grammar job: 'to' before a verb. Extension: a tiny verb sphere."

msgid "pos_tip_adp"
msgstr "Links a noun into the sentence: 'in', 'of', 'like'. Montessori: the green crescent — a bridge between words."

msgid "pos_tip_pron"
msgstr "Stands in the noun's place: 'you', 'who', 'it'. Montessori: the three-part triangle."

msgid "pos_tip_adv"
msgstr "Describes a verb or an adjective: 'very', 'well'. Montessori: the orange sphere rolling beside the verb."

msgid "pos_tip_conj"
msgstr "Joins equal parts: 'and', 'but', 'or'. Montessori: the pink strip stretched between words."

msgid "pos_tip_intj"
msgstr "An exclamation: 'oh', 'wow'. Montessori: the golden diamond."

