#. Pedagogical grammar symbols (Montessori): per-category explanations.
msgid "pos_tip_noun"
msgstr "Montessori: the large black pyramid — solid and stable, the foundation stone of language."

msgid "pos_tip_propn"
msgstr "Montessori extension: the noun pyramid crowned with a small star — a name set apart."

msgid "pos_tip_art"
msgstr "Montessori: the small light-blue pyramid beside its towering black companion."

msgid "pos_tip_adj"
msgstr "Montessori: the medium dark-blue pyramid leaning on the great black one."

msgid "pos_tip_verb"
msgstr "Montessori: the red sphere — the sun that brings the sentence to life."

msgid "pos_tip_aux"
msgstr "Montessori extension: the verb's red sphere drawn as an outline ring."

msgid "pos_tip_part"
msgstr "Montessori extension: a tiny red sphere, the little sibling of the verb."

msgid "pos_tip_adp"
msgstr "Montessori: the green crescent — a little bridge arched between words."

msgid "pos_tip_pron"
msgstr "Montessori: the purple pyramid banded into three parts."

#. Undivided pronoun pyramid of the ru/de symbol systems.
msgid "pos_tip_pron_plain"
msgstr "Montessori: the purple pyramid — a close relative of the black noun pyramid."

msgid "pos_tip_adv"
msgstr "Montessori: the small orange sphere — the moon beside the verb's sun."

msgid "pos_tip_conj"
msgstr "Montessori: the pink strip — a slender ribbon tying words together."

msgid "pos_tip_intj"
msgstr "Montessori: the golden diamond — a bright flash of sudden feeling."

#. Classical keyhole/exclamation interjection of the ru/de symbol systems.
msgid "pos_tip_intj_exclaim"
msgstr "Montessori: the golden exclamation mark — a sudden flash of feeling."

